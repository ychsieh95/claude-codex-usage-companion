# Default text normalization
* text=auto eol=lf

# Source code and .NET project files
*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.resx text eol=lf
*.sln text eol=lf
*.slnx text eol=lf
*.targets text eol=lf

# Configuration and structured data
*.config text eol=lf
*.csv text eol=lf
*.desktop text eol=lf
*.editorconfig text eol=lf
*.ini text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.toml text eol=lf
*.tsv text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Documentation and licenses
*.md text eol=lf
*.txt text eol=lf
LICENSE text eol=lf

# Scripts
*.bash text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf

# Text-based visual assets
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf

# Binary archives, packages, and media
*.7z -text
*.deb -text
*.gif -text
*.gz -text
*.ico -text
*.jpeg -text
*.jpg -text
*.pdf -text
*.png -text
*.tar -text
*.webp -text
*.zip -text

# GitHub language statistics
assets/screenshots/** linguist-documentation=true
